# ----------------------------------------------------------------
# SAP-GRADE ERP CONFIGURATION
# ----------------------------------------------------------------

# 1. Database Connection (Must have WRITE permissions for Migrations)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:password@localhost:5432/sanocare

# 2. Supabase Authentication (Required for "Better Auth")
# Get these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# 3. Security
SECRET_KEY=change-this-to-a-secure-random-string
ENVIRONMENT=development
