[Unit]
Description=KIL API (Gunicorn / Flask)
After=network.target postgresql.service

[Service]
User=root
WorkingDirectory=/root/kil-server
EnvironmentFile=/root/kil-server/.env
ExecStart=/root/kil-server/.venv/bin/gunicorn \
    -c /root/kil-server/gunicorn.conf.py \
    kil.backend.legacy.app:app
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
